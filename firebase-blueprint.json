{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and authentication mappings.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" },
        "walletAddress": { "type": "string" },
        "isAdmin": { "type": "integer" }
      },
      "required": ["name", "email"]
    },
    "Event": {
      "title": "Event",
      "description": "Details about a stellar event.",
      "type": "object",
      "properties": {
        "hostUserId": { "type": "integer" },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "format": { "type": "string" },
        "visibility": { "type": "string" },
        "registrationDeadline": { "type": "string", "format": "date-time" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "prizeTotal": { "type": "number" },
        "prizeBreakdown": { "type": "string" },
        "state": { "type": "string" },
        "fundingTxRef": { "type": "string" },
        "tags": { "type": "string" },
        "capacity": { "type": "integer" },
        "teamSizeMax": { "type": "integer" },
        "bannerUrl": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" }
      },
      "required": ["hostUserId", "title", "category", "format", "visibility"]
    },
    "DatabaseBackup": {
      "title": "DatabaseBackup",
      "description": "A full, consistent SQLite database snapshot for multi-container syncing and cloud durability.",
      "type": "object",
      "properties": {
        "users": { "type": "array" },
        "events": { "type": "array" },
        "event_memberships": { "type": "array" },
        "invitations": { "type": "array" },
        "dev_emails": { "type": "array" },
        "transactions": { "type": "array" },
        "teams": { "type": "array" },
        "team_members": { "type": "array" },
        "sponsors": { "type": "array" },
        "milestones": { "type": "array" },
        "submissions": { "type": "array" },
        "evaluations": { "type": "array" },
        "announcements": { "type": "array" },
        "winners": { "type": "array" },
        "rsvps": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedAt"]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "Customizable and reusable email templates for event invitations.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string" },
        "creatorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "subject", "body", "creatorId"]
    }
  },
  "firestore": {
    "/database_backups/{backupId}": {
      "schema": "DatabaseBackup",
      "description": "Snapshots of the relational database for persistent cloud syncing."
    },
    "/email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Saved reusable email templates managed by event hosts."
    }
  }
}
