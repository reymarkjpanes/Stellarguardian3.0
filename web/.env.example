# ============================================================
# StellarGuardian 3.0 — Environment Variables Reference
# ============================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# All others are server-only.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Public project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon/publishable key — safe for the browser.
# All queries using this key are subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Privileged service-role key — SERVER-ONLY.
# Bypasses RLS. NEVER prefix with NEXT_PUBLIC_ or expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stellar Network ───────────────────────────────────────────
# testnet | mainnet
STELLAR_NETWORK_MODE=testnet

# Set to "true" only when STELLAR_NETWORK_MODE=mainnet is intended
# Guards against accidental mainnet financial operations.
STELLAR_MAINNET_ENABLED=false

# Horizon server URL (leave blank to use SDK default for the network mode)
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ── Soroban Smart Contract ────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ESCROW_CONTRACT_ID=your-deployed-contract-id

# ── KMS Encryption (Req 4.2) ─────────────────────────────────
# Production: AWS KMS envelope encryption.
# Requires @aws-sdk/client-kms and AWS credentials with kms:Encrypt + kms:Decrypt.
# KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/your-key-id
# AWS_REGION=us-east-1

# Development: AES-256-GCM with a local key derived via HKDF.
# REQUIRED for local dev — no hardcoded default (Task 1.2 security fix).
# Use a random 32+ character string. DO NOT use this in production.
LOCAL_ENCRYPTION_KEY=change-me-to-a-random-32-char-string!

# ── Email (Resend) ────────────────────────────────────────────
# Optional — email sending degrades gracefully if not set.
RESEND_API_KEY=re_your_resend_api_key

# ── Rate Limiting (Upstash Redis) ─────────────────────────────
# Required for production — enforces per-user and per-IP rate limits.
# Falls back to no-op (all requests allowed) if not configured (dev convenience).
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ── Cron Jobs ─────────────────────────────────────────────────
# Secret for authenticating cron requests to /api/cron/*.
# Must match the Authorization: Bearer <secret> header sent by scheduler.
# CRITICAL: Without this, cron endpoints are inaccessible (middleware rejects).
CRON_SECRET=your-cron-secret

# ── Error Tracking (Sentry) ───────────────────────────────────
# Optional — configure for production error monitoring.
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0
