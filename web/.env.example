# Supabase project configuration (Req 2.1, 3.1, 14.4).
# Copy this file to `.env.local` and fill in real values from your Supabase
# project settings. Never commit `.env.local` or any file containing real
# secrets to version control.

# Public Supabase project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public (anon/publishable) key — safe to expose to the browser. All
# queries made with this key are subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Privileged service-role key — SERVER-ONLY. Bypasses Row Level Security.
# NEVER prefix with NEXT_PUBLIC_, never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stellar network configuration (Req 4, 25.5, 34.3).
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban smart contract configuration
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ESCROW_CONTRACT_ID=your-deployed-contract-id
# Platform keypair for signing contract invocations (encrypted via KMS in production)
# PLATFORM_SECRET_KEY=S... (only needed for local dev; production uses KMS)

# Resend email service (Req 16.2, 28.5). Optional — email sending degrades
# gracefully if not configured.
RESEND_API_KEY=re_your_resend_api_key

# KMS envelope encryption for escrow keys (Req 4.2). Optional — required
# for production deployments.
# KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789:key/your-key-id
# AWS_REGION=us-east-1

# Local encryption key for development (AES-256-GCM). NOT for production.
# LOCAL_ENCRYPTION_KEY=dev-only-key-never-use-in-production-32b

# Public site URL for SEO (sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
