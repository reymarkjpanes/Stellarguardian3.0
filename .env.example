# =============================================================================
# Stellar Guardian 3.0 — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────

# REQUIRED: Minimum 32 characters. Generate with: openssl rand -hex 32
# Server will CRASH if this is not set.
JWT_SECRET=

# Server port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Public URL of this app (used in email links and invite URLs)
APP_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Email (Resend) ───────────────────────────────────────────────────────────

# Get your API key at: https://resend.com/api-keys
# In development mode, emails are logged to console instead of sent.
RESEND_API_KEY=

# Domain configured in Resend for sending (e.g., mail.yourdomain.com)
EMAIL_DOMAIN=yourdomain.com

# ─── Stellar Network ──────────────────────────────────────────────────────────

# Network: 'testnet' or 'mainnet'
STELLAR_NETWORK=testnet

# Horizon server URL
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Platform escrow keypair (generates + holds escrow accounts for events)
# Generate a new keypair at: https://laboratory.stellar.org/#account-creator?network=test
# Then fund it with Friendbot: https://friendbot.stellar.org/?addr=<PUBLIC_KEY>
STELLAR_ESCROW_SECRET=

# ─── Firebase (Firestore Backup) ──────────────────────────────────────────────

# Firebase project configuration (from Firebase Console → Project Settings → Your apps)
# Used for optional cloud backup of SQLite data.
# NOTE: This is the CLIENT SDK config (safe to expose), NOT a service account key.
FIREBASE_PROJECT_ID=

# ─── AI ───────────────────────────────────────────────────────────────────────

# Required for Gemini AI API calls. Injected automatically in AI Studio.
GEMINI_API_KEY=
